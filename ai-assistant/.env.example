# Configuración de OlimpIA. Normalmente no hace falta tocar este archivo: todo se puede rellenar
# desde la pantalla de Ajustes de la app.

# Clave de la API de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelo a usar (opcional). Debe soportar "tool calling". Por defecto: gpt-5.5.
OPENAI_MODEL=

# Misma base de datos Supabase que usa la web de administración (opcional, ya viene por defecto).
SUPABASE_URL=https://vnockjqtkbhgytmmbdlb.supabase.co

# IMPORTANTE: esta es la "service_role key", NO la "anon key" que usa la web.
# Se obtiene en: Supabase Dashboard -> Settings -> API -> Project API keys -> service_role
# Esta clave salta las reglas de Row Level Security (RLS), así que:
#  - Nunca la subas a git ni la compartas.
#  - Solo debe vivir en este programa, en un ordenador de confianza.
SUPABASE_SERVICE_ROLE_KEY=

# Carpeta con las fichas de los clientes y otros archivos que el asistente puede leer (opcional).
# Por defecto: Documentos\OlimpIA en la app instalada, ./shared-files en desarrollo.
LOCAL_FILES_DIR=
