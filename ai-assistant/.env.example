# Clave de la API de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelo a usar (opcional). Debe soportar "tool calling". Por defecto: gpt-4o.
OPENAI_MODEL=gpt-4o

# Misma base de datos Supabase que usa la web de administración.
# La URL es pública y ya se usa en src/lib/supabase.ts de la app web.
SUPABASE_URL=https://vnockjqtkbhgytmmbdlb.supabase.co

# IMPORTANTE: esta es la "service_role key", NO la "anon key" que usa la web.
# Se obtiene en: Supabase Dashboard -> Settings -> API -> Project API keys -> service_role
# Esta clave salta las reglas de Row Level Security (RLS), así que:
#  - Nunca la subas a git.
#  - Nunca la uses en código de navegador/frontend.
#  - Solo debe vivir en este script de backend, ejecutado localmente o en un servidor de confianza.
SUPABASE_SERVICE_ROLE_KEY=

# Carpeta que el asistente puede leer en cualquier momento (Excels, CSVs...) sin que se la tengas
# que adjuntar cada vez en el chat. Opcional: por defecto usa ./shared-files dentro del proyecto.
# Puedes apuntarla a cualquier carpeta real de tu equipo, p.ej. C:\Users\tú\Documents\GymBotFiles
LOCAL_FILES_DIR=
